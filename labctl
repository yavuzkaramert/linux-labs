#!/usr/bin/env bash
set -euo pipefail

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
LABS_DIR="$SCRIPT_DIR/labs"
SESSIONS_DIR="$SCRIPT_DIR/.sessions"
IMAGE="linux-labs:latest"

die() {
    echo "ERROR: $*" >&2
    exit 1
}

usage() {
    cat <<EOF
Usage: labctl <command> [args]

Commands:
  list             List available labs
  start <id>       Start a lab from scratch (removes old container)
  shell <id>       Open a shell in the lab as the student user
  check <id> [--no-commit]
                   Run the lab's checks and show PASS/FAIL
                   --no-commit: skip the progress commit (verification runs)
  reset <id>       Same as start — rebuild the lab from scratch
  hint <id> [1-3]  Show a hint at the given level (default: 1)
  solution <id>    Show the lab's solution

A lab marked "# ENV: container-systemd" on the first lines of its setup.sh
starts privileged with systemd as PID 1. Every other lab is unaffected.
EOF
    exit 1
}

require_docker() {
    command -v docker >/dev/null 2>&1 ||
        die "docker not found. Install Docker Desktop, OrbStack or Colima first."
}

# Resolve a lab id (full name or numeric prefix) to a directory.
# Sets LAB_DIR, LAB_ID, CONTAINER.
resolve_lab() {
    local id="${1:-}"
    [ -n "$id" ] || usage

    if [ -d "$LABS_DIR/$id" ]; then
        LAB_DIR="$LABS_DIR/$id"
    else
        local matches=("$LABS_DIR/$id"*/)
        [ -d "${matches[0]}" ] || die "lab not found: $id (try: labctl list)"
        [ "${#matches[@]}" -eq 1 ] || die "ambiguous lab id: $id"
        LAB_DIR="${matches[0]%/}"
    fi
    LAB_ID="$(basename "$LAB_DIR")"
    CONTAINER="lab-$LAB_ID"
}

# The environment marker a lab declares on the first lines of its setup.sh:
# "container" (default) or "container-systemd". Labs 001-009 predate the
# second value; a missing or unreadable marker means "container", so nothing
# about their startup changes.
lab_env() {
    local marker
    marker="$(sed -n '1,3s/^# ENV:[[:space:]]*//p' "$LAB_DIR/setup.sh" 2>/dev/null | head -1)"
    case "$marker" in
        container-systemd) echo "container-systemd" ;;
        *)                 echo "container" ;;
    esac
}

# systemd needs a moment to reach a usable state. Without this wait, setup.sh
# would fire systemctl calls at a half-booted PID 1 and fail at random.
# "degraded" counts as ready: a lab whose setup deliberately leaves a service
# broken is exactly that, and waiting for "running" would time out.
wait_systemd() {
    local i state
    for i in $(seq 1 30); do
        state="$(docker exec "$CONTAINER" systemctl is-system-running 2>/dev/null || true)"
        case "$state" in
            running|degraded) return 0 ;;
        esac
        sleep 1
    done
    die "systemd did not come up in $CONTAINER (last state: ${state:-none})"
}

ensure_image() {
    if ! docker image inspect "$IMAGE" >/dev/null 2>&1; then
        echo "Building image $IMAGE ..."
        docker build -t "$IMAGE" "$SCRIPT_DIR"
    fi
}

cmd_list() {
    [ -d "$LABS_DIR" ] || die "no labs directory: $LABS_DIR"
    local dir id title
    for dir in "$LABS_DIR"/*/; do
        [ -d "$dir" ] || continue
        id="$(basename "$dir")"
        title="$(grep -m1 '^#' "$dir/TASK.md" 2>/dev/null | sed 's/^#* *//' || true)"
        # 007'den itibaren TASK.md setext başlık kullanıyor (`#` yok) — başlık
        # satırı altındaki `===`/`---` çizgisinden okunur.
        [ -n "$title" ] || title="$(awk 'NR==2 && /^[=-]{3,}[[:space:]]*$/ {print prev}
                                        {prev = $0}' "$dir/TASK.md" 2>/dev/null || true)"
        printf '%-24s %s\n' "$id" "${title:-}"
    done
}

cmd_start() {
    resolve_lab "$1"
    require_docker
    ensure_image

    # Session dir survives the container: history and exit codes are the raw
    # material for the debrief, so they live on the host, not inside the box.
    local session_dir="$SESSIONS_DIR/$LAB_ID"
    mkdir -p "$session_dir"

    docker rm -f "$CONTAINER" >/dev/null 2>&1 || true
    # SYS_NICE is not in Docker's default capability set. Without it a setup.sh
    # that lowers a process's nice value fails silently (warning on stderr,
    # exit 0), so lab 005 would hand out its nice criterion for free.
    local env_kind
    env_kind="$(lab_env)"
    local -a run_args=(-d --name "$CONTAINER" --cap-add SYS_NICE
                       -v "$session_dir:/session")
    local -a run_cmd=()
    # Lab 010 teaches systemd, which cannot be taught under a "sleep infinity"
    # PID 1. The privileged/cgroup flags below were measured against OrbStack,
    # not assumed. Deliberately a single if — CONTEXT.md forbids growing a
    # general environment plugin system out of this.
    if [ "$env_kind" = "container-systemd" ]; then
        run_args=(-d --name "$CONTAINER" --privileged --cgroupns=host
                  -v /sys/fs/cgroup:/sys/fs/cgroup:rw
                  -v "$session_dir:/session")
        run_cmd=(/usr/sbin/init)
    fi
    # ${arr[@]+"${arr[@]}"}: macOS ships bash 3.2, where an empty array under
    # `set -u` is an unbound variable. The guard keeps the non-systemd command
    # line byte-for-byte identical to what it has always been.
    docker run "${run_args[@]}" "$IMAGE" ${run_cmd[@]+"${run_cmd[@]}"} >/dev/null
    if [ "$env_kind" = "container-systemd" ]; then
        wait_systemd
    fi
    # The bind mount hides the image's /session, so re-assert student can write.
    docker exec -u root "$CONTAINER" \
        sh -c 'chown student:student /session 2>/dev/null || chmod 0777 /session'
    docker exec "$CONTAINER" mkdir -p /lab
    docker cp "$LAB_DIR/." "$CONTAINER:/lab/"
    docker exec -u root "$CONTAINER" bash /lab/setup.sh

    echo "Lab '$LAB_ID' ready."
    echo "Task: /lab/TASK.md  (inside shell: cat /lab/TASK.md)"
    echo "Enter with: labctl shell $LAB_ID"
}

cmd_shell() {
    resolve_lab "$1"
    require_docker
    docker exec -it "$CONTAINER" su - student
}

# Commit progress after a passed check. The lab is solved inside the
# container, so the host tree stays clean — record the pass in
# PROGRESS.md to have something to commit. Only PROGRESS.md is staged
# and committed, so any other pending work in the tree is left alone.
# Silently a no-op when git is missing, this is not a repo, or the
# pass is already recorded.
auto_commit() {
    command -v git >/dev/null 2>&1 || return 0
    git -C "$SCRIPT_DIR" rev-parse --is-inside-work-tree >/dev/null 2>&1 || return 0
    local progress="$SCRIPT_DIR/PROGRESS.md"
    [ -f "$progress" ] || printf '# Progress\n\n' > "$progress"
    if ! grep -q "^- $LAB_ID solved" "$progress"; then
        printf -- '- %s solved (%s)\n' "$LAB_ID" "$(date +%Y-%m-%d)" >> "$progress"
    fi
    git -C "$SCRIPT_DIR" add -- PROGRESS.md
    git -C "$SCRIPT_DIR" diff --cached --quiet -- PROGRESS.md && return 0
    git -C "$SCRIPT_DIR" commit -q -m "lab $LAB_ID solved" -- PROGRESS.md
    echo "İlerleme commitlendi: lab $LAB_ID solved"
}

# Debrief girdisi: oturumun komut geçmişi, zaman damgalı.
# Pencere DEBRIEF_HOURS ile ayarlanır (varsayılan 24 saat).
debrief_history() {
    local h="${DEBRIEF_HOURS:-24}"
    echo ""
    echo "--- debrief history (son ${h} saat) ---"
    docker exec "$CONTAINER" bash -lc '
        [ -r /session/history ] || { echo "(oturum geçmişi bulunamadı)"; exit 0; }
        since=$(date -d "'"$h"' hours ago" +%s)
        gawk -v since="$since" '"'"'
            /^#/          { t = substr($0, 2) + 0; next }
            $0 == "clear" { next }
            t >= since    { print strftime("%H:%M", t), $0 }
        '"'"' /session/history
    '
}

# --no-commit exists for verification runs (regression sweeps, authoring a new
# lab). Those pass the check without the lab actually having been solved, and
# the resulting commit puts a wrong-dated "solved" line in PROGRESS.md.
cmd_check() {
    resolve_lab "$1"
    local no_commit=0
    case "${2:-}" in
        --no-commit) no_commit=1 ;;
        '')          ;;
        *)           die "usage: labctl check <id> [--no-commit]" ;;
    esac
    require_docker
    if docker exec -u root "$CONTAINER" bash /lab/check.sh; then
        echo ""
        echo "SONUÇ: GEÇTİ ✅"
        [ "$no_commit" -eq 1 ] || auto_commit
        debrief_history
    else
        echo ""
        echo "SONUÇ: KALDI ❌"
        exit 1
    fi
}

cmd_hint() {
    resolve_lab "$1"
    local level="${2:-1}"
    case "$level" in
        1|2|3) ;;
        *) die "usage: labctl hint <id> [1|2|3]" ;;
    esac
    [ -f "$LAB_DIR/hints.md" ] ||
        die "Bu lab'da hints.md yok (001 eski formatta)."
    local section
    section="$(awk -v lvl="$level" '/^## /{p = ($0 == "## Seviye " lvl)} p' "$LAB_DIR/hints.md")"
    [ -n "$section" ] || die "hints.md içinde \"## Seviye $level\" bölümü yok"
    echo "$section"
}

cmd_solution() {
    resolve_lab "$1"
    [ -f "$LAB_DIR/solution.md" ] || die "no solution.md for $LAB_ID"
    cat "$LAB_DIR/solution.md"
}

main() {
    local cmd="${1:-}"
    shift || true
    case "$cmd" in
        list)      cmd_list ;;
        start)     cmd_start "${1:-}" ;;
        shell)     cmd_shell "${1:-}" ;;
        check)     cmd_check "${1:-}" "${2:-}" ;;
        reset)     cmd_start "${1:-}" ;;
        hint)      cmd_hint "${1:-}" "${2:-1}" ;;
        solution)  cmd_solution "${1:-}" ;;
        *)         usage ;;
    esac
}

main "$@"
